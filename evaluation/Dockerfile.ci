ARG BASE_IMAGE=rocm/ali-private:ubuntu22.04_rocm7.14.0_cp310_torch2.12.0_sglang_4d63dea_aiter_514c166_20261105_v2
FROM ${BASE_IMAGE}

# Standalone concurrency client; add its missing packages without resolving or
# upgrading the base image's serving runtime dependencies.
RUN python3 -m pip install --no-deps --no-cache-dir \
    aliyun-python-sdk-core==2.16.1 aliyun-python-sdk-kms==2.16.5 \
    crcmod==1.7 jmespath==1.1.0 oss2==2.19.1 pycryptodome==4.2.0

ARG AITER_REF=qwen38-flash-next-dev
ENV AITER_USE_SYSTEM_TRITON=1 GPU_ARCHS=gfx942 PYTORCH_ROCM_ARCH=gfx942 SGLANG_BUILD_RUST_EXTS=none PYTHONPATH=""

# mori runs the Qwen4 sequence-parallel collectives over SDMA; its build needs the
# ibverbs headers, which the base image lacks. Installed here because the candidate's
# srt_hip extras pin it by URL, which the requirement check below cannot install.
RUN apt-get update && apt-get install -y --no-install-recommends libibverbs-dev && \
    rm -rf /var/lib/apt/lists/*
RUN MORI_GPU_ARCHS=gfx942 python3 -m pip install --no-cache-dir \
    "amd_mori @ git+https://github.com/ROCm/mori.git@de97ceacefa96a6ba45b5ed3276abdb4a3bf7fd6"

# CI resolves companion branches once per run; keep the evaluator pinned.
RUN git init /ci/aiter && \
    git -C /ci/aiter remote add origin https://github.com/apinge/aiter.git && \
    git -C /ci/aiter fetch --depth=1 origin "$AITER_REF" && \
    git -C /ci/aiter checkout --detach FETCH_HEAD && \
    git -C /ci/aiter submodule update --init --recursive
ARG PYHIP_REF=dev
RUN git init /ci/pyhip && \
    git -C /ci/pyhip remote add origin https://github.com/tingqli/pyhip.git && \
    git -C /ci/pyhip fetch --depth=1 origin "$PYHIP_REF" && \
    git -C /ci/pyhip checkout --detach FETCH_HEAD && \
    git -C /ci/pyhip submodule update --init --recursive
RUN git init /ci/client && \
    git -C /ci/client remote add origin https://github.com/apinge/sglang.git && \
    git -C /ci/client fetch --depth=1 origin fc6ddbbf7aac80167ea04cc00bf200af8adf2b85 && \
    git -C /ci/client checkout --detach FETCH_HEAD

ARG SGLANG_SOURCE=.
COPY ${SGLANG_SOURCE} /ci/sglang
# Keep the current CI recipes when testing an older candidate revision.
COPY evaluation /ci/sglang/evaluation
COPY scripts/ci/qwen4_ci.py /ci/sglang/scripts/ci/qwen4_ci.py
RUN python3 /ci/sglang/scripts/ci/qwen4_ci.py install
WORKDIR /ci/sglang
ENTRYPOINT []
CMD ["python3", "scripts/ci/qwen4_ci.py", "--output", "/results"]
